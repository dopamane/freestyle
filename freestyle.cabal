cabal-version:      3.0
name:               freestyle
version:            0.1.0.0
synopsis:           Freestyle TUI graphics
description:        Concurrent terminal user interface graphics
license:            MIT
license-file:       LICENSE
author:             dopamane
maintainer:         dwc1295@gmail.com
copyright:          (c) David Cox
category:           Graphics
build-type:         Simple
extra-doc-files:    CHANGELOG.md

library
    ghc-options:      -Wall -Wunused-packages -O2
    exposed-modules:  Freestyle,
                      Freestyle.Display,
                      Freestyle.Freestyle
    build-depends:    async
                    , base < 5.0
                    , bytestring
                    , prettyprinter
                    , prettyprinter-ansi-terminal
                    , stm
                    , text
    hs-source-dirs:   lib
    default-language: Haskell2010

executable fs
    ghc-options:      -Wall -O2 -threaded
    main-is:          Main.hs
    build-depends:
        base,
        freestyle

    hs-source-dirs:   exe
    default-language: Haskell2010

test-suite test
    ghc-options:      -Wall -O2 -threaded
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base,
        freestyle
